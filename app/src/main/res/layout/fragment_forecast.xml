<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ForecastFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#a3e2f7"
        android:layout_margin="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="Mon"
                android:gravity="center">
            </TextView>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                app:srcCompat="@drawable/cloudysun">
            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="Cloudy day"
                    android:layout_weight="1">
                </TextView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="34C - 31C"
                    android:layout_weight="1">
                </TextView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="Tue"
                android:gravity="center">
            </TextView>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                app:srcCompat="@drawable/cloud">
            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="Showers day"
                    android:layout_weight="1">
                </TextView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="24C - 30C"
                    android:layout_weight="1">
                </TextView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="Wed"
                android:gravity="center">
            </TextView>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                app:srcCompat="@drawable/cloudlight">
            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="Lightning day"
                    android:layout_weight="1">
                </TextView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="24C - 30C"
                    android:layout_weight="1">
                </TextView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="Thu"
                android:gravity="center">
            </TextView>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                app:srcCompat="@drawable/cloud">
            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="Showers day"
                    android:layout_weight="1">
                </TextView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="24C - 30C"
                    android:layout_weight="1">
                </TextView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="Fri"
                android:gravity="center">
            </TextView>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                app:srcCompat="@drawable/raincloud">
            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="Showers day"
                    android:layout_weight="1">
                </TextView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="24C - 30C"
                    android:layout_weight="1">
                </TextView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>